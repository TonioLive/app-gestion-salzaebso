# Credenciales, configuraciones privadas y estado local
**/.private/
**/.env
**/.env.*
!**/.env.example
**/*.local.php
**/*.local.json
**/auth.json
**/.htpasswd
**/.htpasswds
**/.jwt-secret
**/.aws/
**/.ssh/
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.cer
**/*.crt

# Dependencias regenerables y herramientas locales
**/node_modules/
/apps/*/vendor/
**/.vscode/
**/.idea/
**/.DS_Store
**/Thumbs.db

# Copias, volcados, registros y documentos generados
**/*.log
**/*.bak
**/*.backup
**/*.old
**/*~
**/*.zip
**/*.rar
**/*.7z
**/*.tar
**/*.gz
**/*.sql
!apps/*/database/schema.sql
!apps/lapices/configuracion/migraciones/*.sql
!apps/lapices/modernizacion/sql/*.sql
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.mdb
**/*.accdb
**/*.xls
**/*.xlsx
**/*.csv
**/*.pdf
**/*.doc
**/*.docx
**/*.mp4
**/*.mov
**/*.avi
**/*.mp3
**/sess_*
**/error_log
**/debug.log

# Los directorios de datos se crean al instalar; no versionar su contenido.
**/fotos_usuarios/*
!**/fotos_usuarios/.gitkeep
!**/fotos_usuarios/.htaccess
!**/fotos_usuarios/sin_foto.*
!**/fotos_usuarios/avatar.png
!**/fotos_usuarios/nada.gif
!**/fotos_usuarios/nada.jpg
**/dni_usuarios/*
!**/dni_usuarios/.gitkeep
!**/dni_usuarios/.htaccess
!**/dni_usuarios/sin_dni.jpg
**/firma_usuarios/*
!**/firma_usuarios/.gitkeep
!**/firma_usuarios/.htaccess
!**/firma_usuarios/sin_firma.jpg
**/certificados/*
!**/certificados/.gitkeep
!**/certificados/*.php
**/tmp/*
!**/tmp/.gitkeep

# Capturas de cámara, firmas y escaneos incrustados en rutas antiguas
**/webcam/imag/cam*.jpg
**/webcam/imag/cam*.jpeg
**/pdf/[0-9]/*.jpg
**/pdf/[0-9]/*.png
**/pdf/[0-9][0-9]/*.jpg
**/pdf/[0-9][0-9]/*.png
**/FIRMA*.jpg
**/FIRMA*.jpeg
**/FIRMA*.png
**/firma_recibos.jpg
**/imag/popup/*.jpg
**/imag/popup/*.jpeg
**/imag/popup/*.png
**/imag/popup/*.gif
**/imag/veraula*.jpg
**/gestion/grupos*/imagenes/*
!**/gestion/grupos*/imagenes/.gitkeep
!**/gestion/grupos*/imagenes/.htaccess
!**/gestion/grupos*/imagenes/*.php
!**/gestion/grupos*/imagenes/sin_imagen.jpg

# Informes de comprobación y archivos de uso personal
/local/
/reports/
*.code-workspace
